# Template only. NO real credentials or user data in GitHub.
# The Go app reads OS environment variables; this example is NOT auto-loaded.
# Current Go runtime: internal/config/config.go, cmd/itmap/main.go
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# MariaDB: localhost-only. Disable until isolated staging database is ready.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itmap_staging
DB_USER=itmap_app
DB_PASSWORD=

# Auth: enable only after secrets are supplied securely outside Git.
AUTH_ENABLED=false
SESSION_SECRET=
SITE_PASSWORD=
NASTYA_PASSWORD=
DEMO_PASSWORD=

# Static frontend build directory (optional until Vite build succeeds)
WEB_DIST_DIR=

# Legacy/provider integration names: referenced by the Sites JS code,
# but corresponding Go clients are NOT yet implemented.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Test-only optional DSN used by Go integration tests.
# Never point it to a production database; leave empty by default.
# ITMAP_TEST_MARIADB_DSN=
