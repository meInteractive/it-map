NASTYA_PASSWORD=
DEMO_PASSWORD=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Set to absolute path to Vite output once built
WEB_DIST_DIR=
