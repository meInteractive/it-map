# Шаблон конфигурации, без реальных секретов и пользовательских данных.
# Go читает окружение процесса; .env автоматически НЕ загружается.
# Запуск/деплой/обязательность переменных: docs/user/deployment/LOCAL.md
# Локально скопировать в .env (не отслеживается Git), на сервере — в
# /etc/itmap/main.env и /etc/itmap/dev.env с mode 0600.
# Это шаблон ОДНОГО процесса: создать два файла с теми же именами переменных.
# По решению пользователя DB_HOST/PORT/USER/PASSWORD общие, DB_NAME разный.
# SESSION_SECRET и пароли аккаунтов main/dev задаются отдельно.
# Для совместимости shell/systemd/Docker: простые KEY=value, hex-секреты;
# правила кавычек для сложных значений у загрузчиков различаются.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# MariaDB: localhost-only. Staging requires DB_ENABLED=true and AUTH_ENABLED=true.
# Only literal true/false are accepted; other spellings cause startup failure.
# Keep both false in development until services are configured.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth: включать только после заполнения секретов вне Git.
AUTH_ENABLED=false
# Обязательно при AUTH_ENABLED=true: случайный секрет минимум 32 байта.
SESSION_SECRET=
# Обязательный пароль администратора eugene при AUTH_ENABLED=true.
SITE_PASSWORD=
# Необязательные: пустые значения выключают дополнительные аккаунты.
NASTYA_PASSWORD=
DEMO_PASSWORD=

# Абсолютный путь к dist/web (native) или /app/web (Docker).
# Не указывать корень репозитория. Без готового index.html HTML вернёт 503.
WEB_DIST_DIR=

# Legacy/provider integration names: referenced by the Sites JS code,
# but corresponding Go clients are NOT yet implemented.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Test-only optional DSN used by Go integration tests.
# Never point it to a production database; leave empty by default.
# ITMAP_TEST_MARIADB_DSN=
