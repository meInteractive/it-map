[Unit]
Description=it-map continuous worker
After=network-online.target mariadb.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=itmap-worker
Group=itmap-worker
EnvironmentFile=/etc/itmap/worker.env
WorkingDirectory=/opt/itmap/worker/current
ExecStart=/opt/itmap/worker/current/itmap-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
RuntimeDirectory=itmap-worker
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
RestrictSUIDSGID=true
CapabilityBoundingSet=
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
