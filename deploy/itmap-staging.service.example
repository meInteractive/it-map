[Unit]
Description=it-map Go staging (migration shell only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=itmap
Group=itmap
EnvironmentFile=/etc/itmap/staging.env
ExecStart=/opt/itmap/bin/itmap
WorkingDirectory=/opt/itmap
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
LimitNOFILE=65536
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
