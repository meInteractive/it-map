[Unit]
Description=IT-MAP 15-minute parser pilot
After=network-online.target itmap@main.service
Requires=itmap@main.service

[Service]
Type=oneshot
User=itmap-main
Group=itmap-main
EnvironmentFile=/etc/itmap/main-scheduler.env
ExecStart=/usr/bin/python3 /usr/local/libexec/itmap-scheduler-tick.py
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
